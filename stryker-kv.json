{
  "stryker-config": {
    "project": "Synkrolyn.csproj",
    "test-projects": ["tests/Synkrolyn.Tests/Synkrolyn.Tests.csproj"],
    "configuration": "Release",
    "mutation-level": "Basic",
    "thresholds": { "high": 80, "low": 68, "break": 68 },
    "concurrency": 4,
    "additional-timeout": 30000,
    "timeout-ratio": 2,
    "test-case-filter": "FullyQualifiedName!~PushSeeds&FullyQualifiedName!~StaleLocalRead&FullyQualifiedName!~Socket&FullyQualifiedName!~DeterministicSimulatorTests",
    "reporters": ["cleartext", "json"],
    "mutate": [
      "**/Kv/**/*.cs",
      "**/Raft/InMemoryRaftLog.cs",
      "**/Raft/InMemoryPersistentState.cs",
      "**/Raft/LogEntry.cs",
      "**/Raft/MembershipCodec.cs",
      "**/Net/InMemoryTransport.cs"
    ]
  }
}
